# Hostinger MySQL
DB_HOST=your-hostinger-mysql-host
DB_PORT=3306
DB_NAME=your_database_name
DB_USER=your_database_user
DB_PASSWORD=your_database_password

# Application (configure these on the main website Web App)
ATTENDANCE_ENABLED=true
APP_TIMEZONE=Asia/Kolkata
ATTENDANCE_JWT_SECRET=replace-with-a-long-random-secret
ATTENDANCE_COOKIE_NAME=attendance_session

# First admin account (created automatically if no admin exists)
ATTENDANCE_ADMIN_NAME=Company Administrator
ATTENDANCE_ADMIN_EMAIL=admin@yourcompany.com
ATTENDANCE_ADMIN_PASSWORD=replace-with-a-strong-password
